import os

project = SteamWorks.HL2Project(builder, 'steamworks.ext')
project.sources += [
  'extension.cpp',
  'core/swgameserver.cpp',
  'core/swclientlifecycle.cpp',
  'core/swdebug.cpp',
  'core/swidentity.cpp',
  'core/swgamedata.cpp',
  'core/swforwards.cpp',
  'natives/gsnatives.cpp',
  'hooks/swgshooks.cpp',
  'hooks/swgsdetours.cpp',
  'natives/ssnatives.cpp',
  'natives/gcnatives.cpp',
  'http/swhttp.cpp',
  'http/swhttprequest.cpp',
  'hooks/swgchooks.cpp',
  'sdk/smsdk_ext.cpp',
  'CDetour/detours.cpp',
  'asm/asm.c'
]

for sdk_name in SteamWorks.sdks:
  sdk = SteamWorks.sdks[sdk_name]

  binary = SteamWorks.HL2Config(project, builder.cxx, 'steamworks.ext.' + sdk.ext, sdk)

  binary.compiler.defines += ['META_NO_HL2SDK', 'SOURCEMOD_BUILD', 'VERSION_SAFE_STEAM_API_INTERFACES']
  binary.compiler.cxxincludes += [
    os.path.join(SteamWorks.steamworks_root, 'public', 'steam'),
    os.path.join(sdk.path, 'public', 'steam'),
  ]

  if binary.compiler.target.platform in ['linux', 'mac']:
    # Rebuild the ConVar dependency closure as PIC instead of linking legacy
    # archive objects with absolute text relocations. SDK headers are external.
    binary.sources += [os.path.join(sdk.path, 'tier1', source) for source in
                       ['convar.cpp', 'strtools.cpp', 'utlbuffer.cpp', 'characterset.cpp', 'utlstring.cpp']]
    binary.compiler.defines += ['_alloca=alloca']
    binary.compiler.cxxflags += ['-isystem', os.path.join(sdk.path, 'public')]

  if binary.compiler.target.platform == 'linux':
    binary.compiler.postlink += (
      os.path.join(SteamWorks.steamworks_root, 'redistributable_bin', 'linux32', 'libsteam_api.so'),
      # SourceMod loads extensions locally: tier1's diagnostic imports must
      # have an explicit provider, not rely on the engine's loader scope.
      '-L' + os.path.join(sdk.path, 'lib', 'linux'),
      '-ltier0_srv',
    )
    binary.compiler.linkflags += ['-Wl,-rpath,$ORIGIN/../../../../bin']

  if binary.compiler.target.platform == 'windows':
    # ConVar's tier1 closure imports diagnostics and the allocator from tier0.
    binary.compiler.postlink += tuple(os.path.join(sdk.path, 'lib', 'public', library)
                                      for library in ['tier1.lib', 'tier0.lib'])
    binary.compiler.postlink += (
      os.path.join(SteamWorks.steamworks_root, 'redistributable_bin', 'steam_api.lib'),
    )

  if binary.compiler.target.platform == 'mac':
    binary.compiler.postlink += (
      os.path.join(SteamWorks.steamworks_root, 'redistributable_bin', 'osx', 'libsteam_api.dylib'),
    )

SteamWorks.extensions += builder.Add(project)
