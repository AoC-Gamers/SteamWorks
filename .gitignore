# Compiled objects and libraries
*.slo
*.lo
*.o
*.obj
*.so
*.dylib
*.dll
*.lai
*.la
*.a
*.lib

# Executables and compiled SourcePawn plugins
*.exe
*.smx

# visual studio
*.sdf
*.opensdf

# user files
*.suo
*.user

# msvc temporaries/binaries
[Dd]ebug - */
[Rr]elease - */
[Dd]ebug/
[Rr]elease/
# Repository-local dependencies and generated output; do not hide nested fixtures.
/.deps/
/.build/
/.output/
/dist/
/sdk/
/sdk_*/

# Tool caches may occur anywhere in the source tree.
__pycache__/
*.pyc
node_modules/

# Generated archives and local configuration
*.zip
.env
/env.secret
/.scannerwork/
