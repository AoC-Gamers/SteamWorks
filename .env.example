# Copy to .env and override only what you need locally.
# Existing process variables take precedence over .env.
# make supplies DEPS_DIR, BUILD_DIR and STEAMWORKS_SDK_*; override them via
# make variables such as LINUX_DEPS_DIR, WINDOWS_BUILD_DIR or STEAMWORKS_SDK_DIR.

# Internal Linux build paths (use Make entrypoints and absolute paths).
# DEPS_DIR=/ruta/SteamWorks/.deps/exts-linux
# BUILD_DIR=/ruta/SteamWorks/.build/linux-l4d2
# HL2SDK_DIR=/ruta/SteamWorks/.deps/exts-linux/hl2sdk-l4d2
# SOURCEMOD_DIR=/ruta/SteamWorks/.deps/exts-linux/sourcemod-1.12
# MMSOURCE_DIR=/ruta/SteamWorks/.deps/exts-linux/mmsource-1.12
# AMBUILD_DIR=/ruta/SteamWorks/.deps/exts-linux/ambuild
# VENV_DIR=/ruta/SteamWorks/.deps/exts-linux/.venv-linux
# CONFIGURE_SCRIPT=/ruta/SteamWorks/configure.py

# Internal Windows build paths (choose one platform per .env).
# DEPS_DIR=C:/ruta/SteamWorks/.deps/exts-windows
# BUILD_DIR=C:/ruta/SteamWorks/.build/windows-l4d2
# VENV_DIR=C:/ruta/SteamWorks/.deps/exts-windows/.venv-windows
# Other dependency paths default to subdirectories of DEPS_DIR.

# SteamWorks SDK overrides (adjust the absolute path for your platform).
# STEAMWORKS_SDK_NAME=sdk_155
# STEAMWORKS_SDK_DIR=/ruta/SteamWorks/sdk_155

# Windows-specific override; normally Visual Studio is detected via vswhere.exe.
# VCVARSALL_PATH=C:/Program Files/Microsoft Visual Studio/2022/BuildTools/VC/Auxiliary/Build/vcvarsall.bat

# Configuración local de SonarQube; token solo en env.secret.
SONAR_HOST_URL=
SONAR_PROJECT_KEY=SteamWorks
SONAR_PROJECT_NAME=SteamWorks
SONAR_QUALITY_GATE_WAIT=true
SONAR_QUALITY_GATE_TIMEOUT=300
# Vacío: usa compile_commands.json del LINUX_BUILD_DIR seleccionado en Make.
SONAR_COMPILE_COMMANDS=
