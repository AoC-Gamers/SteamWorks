# Copy to .env and override only what you need locally.

# Common paths
# DEPS_DIR=C:\GitHub\SteamWorks\.deps
# BUILD_DIR=C:\GitHub\SteamWorks\.build\linux-l4d2
# HL2SDK_DIR=C:\GitHub\SteamWorks\.deps\hl2sdk-l4d2
# SOURCEMOD_DIR=C:\GitHub\SteamWorks\.deps\sourcemod-1.12
# MMSOURCE_DIR=C:\GitHub\SteamWorks\.deps\mmsource-1.12
# AMBUILD_DIR=C:\GitHub\SteamWorks\.deps\ambuild
# VENV_DIR=C:\GitHub\SteamWorks\.deps\.venv-linux
# CONFIGURE_SCRIPT=C:\GitHub\SteamWorks\configure.py

# SteamWorks SDK overrides
# STEAMWORKS_SDK_NAME=sdk_158a
# STEAMWORKS_SDK_DIR=C:\GitHub\SteamWorks\sdk_158a

# Windows-specific overrides
# VCVARSALL_PATH=C:\Program Files\Microsoft Visual Studio\18\Insiders\VC\Auxiliary\Build\vcvarsall.bat
